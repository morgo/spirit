|	"AS" Identifier
	{
		$$ = &insertRowAlias{rowAlias: ast.NewCIStr($2)}
	}
|	"AS" Identifier '(' IdentList ')'
	{
		$$ = &insertRowAlias{rowAlias: ast.NewCIStr($2), columnAliases: $4.([]ast.CIStr)}
