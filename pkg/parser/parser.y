		ret := &ast.GrantStmt{
			Privs:                 p,
			ObjectType:            $4.(ast.ObjectTypeType),
			Level:                 $5.(*ast.GrantLevel),
			Users:                 $7.([]*ast.UserSpec),
			AuthTokenOrTLSOptions: $8.([]*ast.AuthTokenOrTLSOption),
			WithGrant:             $9.(bool),
