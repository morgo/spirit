	Identifier IdentListWithParenOpt "AS" SubSelect
	{
		cte := &ast.CommonTableExpression{}
		cte.Name = ast.NewCIStr($1)
		cte.ColNameList = $2.([]ast.CIStr)
		cte.Query = $4.(*ast.SubqueryExpr)
		$$ = cte
